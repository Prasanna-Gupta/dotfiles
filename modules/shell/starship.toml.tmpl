# prasanna-os:generated — rendered from modules/shell/starship.toml.tmpl by hook 05.
# Edit the template in the repo, not ~/.config/starship.toml.

format = """
$directory\
$git_branch\
$git_status\
$fill\
$nodejs\
$python\
$java\
$rust\
$golang\
$cmd_duration\
$line_break\
$character
"""

add_newline = false

[directory]
style = "bold __ACCENT__"
truncation_length = 3
truncate_to_repo = false

[git_branch]
symbol = " "
format = "[$symbol$branch]($style) "
style = "__ACCENT__"

[git_status]
style = "dimmed white"
format = "([$all_status$ahead_behind]($style) )"

[fill]
symbol = " "

[cmd_duration]
min_time = 1000
format = "[$duration](dimmed white)"

[character]
success_symbol = "[❯](bold __ACCENT__)"
error_symbol = "[❯](bold red)"

[python]
format = "[$symbol$version( \\($virtualenv\\))]($style) "
style = "dimmed white"
symbol = " "

[nodejs]
format = "[$symbol$version]($style) "
style = "dimmed white"
symbol = " "

[java]
format = "[$symbol$version]($style) "
style = "dimmed white"
symbol = " "

[rust]
format = "[$symbol$version]($style) "
style = "dimmed white"

[golang]
format = "[$symbol$version]($style) "
style = "dimmed white"
